# Copy to .env. Only MAILCRAFT_SECRET_KEY is required for compose.
# generate: echo "MAILCRAFT_SECRET_KEY=$(openssl rand -base64 32)" > .env
MAILCRAFT_SECRET_KEY=
POSTGRES_PASSWORD=mailcraft
# Optional; compose passes these through from .env:
# MAILCRAFT_PORT=8080                   host port of the API
# MAILCRAFT_DASHBOARD_PORT=3000         host port of the dashboard
# MAILCRAFT_PUBLIC_URL=http://localhost:8080   recipient-reachable URL (unsubscribe links)
# MAILCRAFT_EGRESS_IP=                  your sending IP (domain add SPF, doctor fcrdns)
# OPENROUTER_API_KEY=                   LLM-written emails
# MAILCRAFT_LLM_MODEL=                  default deepseek/deepseek-v4-flash
# MAILCRAFT_LLM_FALLBACK_MODELS=        comma-separated models tried when the first fails
# MAILCRAFT_LLM_REASONING=off           off|low|medium|high (OpenRouter)
# MAILCRAFT_LLM_GUARDRAILS=default      default|spicrawl
# CLOUDFLARE_API_TOKEN=                 auto-create DNS records
# Not passed by compose: REDIS_URL (compose wires redis itself)
