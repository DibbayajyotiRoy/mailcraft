# Copy to .env. Only MAILCRAFT_SECRET_KEY is required for compose.
# generate: echo "MAILCRAFT_SECRET_KEY=$(openssl rand -base64 32)" > .env
MAILCRAFT_SECRET_KEY=
POSTGRES_PASSWORD=mailcraft
# Optional (set inside the mailcraft service environment):
# REDIS_URL=redis://redis:6379          throttles/locks; never needed for correctness
# OPENROUTER_API_KEY=                   LLM-written emails
# CLOUDFLARE_API_TOKEN=                 auto-create DNS records
