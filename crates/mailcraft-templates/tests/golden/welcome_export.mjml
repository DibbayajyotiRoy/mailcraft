<mjml><mj-head><mj-title>Welcome {{ first_name }}</mj-title><mj-preview>Your account is ready</mj-preview></mj-head><mj-body><mj-section><mj-column><mj-text font-size="22px" font-weight="bold">Hi {{ first_name }}</mj-text><mj-text>Thanks for joining &amp; welcome.</mj-text><!--mc-slot:{"type":"slot","name":"intro","max_len":200,"instructions":"One friendly sentence.","fallback":"Thanks for joining."}--><mj-text>{{ slots['intro'] }}</mj-text><mj-image src="https://example.com/logo.png" alt="Logo" width="120px" /><mj-button href="{{ app_url }}">Open app</mj-button><mj-divider /><mj-spacer height="10px" /></mj-column></mj-section><mj-section><mj-column><mj-text>Left</mj-text></mj-column><mj-column><mj-text>Right</mj-text></mj-column></mj-section></mj-body></mjml>