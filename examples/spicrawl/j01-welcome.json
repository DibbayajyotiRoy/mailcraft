{
  "journey": "J1",
  "title": "Welcome (signed up)",
  "source": "mailer-research/journeys.md",
  "automations": [
    {
      "name": "J1 Welcome",
      "status": "draft",
      "entry_rule": "once",
      "goal": {
        "events": [
          "onboarding_completed",
          "first_request_made"
        ]
      },
      "approval": "first_n:5",
      "steps": [
        {
          "key": "trigger",
          "type": "trigger",
          "config": {
            "event": "signed_up"
          },
          "next": "wait"
        },
        {
          "key": "wait",
          "type": "delay",
          "config": {
            "duration": "5m"
          },
          "next": "welcome"
        },
        {
          "key": "welcome",
          "type": "send_email",
          "config": {
            "template": "spicrawl-welcome",
            "topic": "product",
            "weekend_ok": true,
            "instructions": "Founder voice, 2-3 sentences, one next step. Facts only from context.",
            "mode": "llm"
          }
        }
      ]
    }
  ]
}
