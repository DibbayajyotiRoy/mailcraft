 {
  "name": "email_send",
  "description": "Send (queue) one email. Result status is queued or pending_approval (poll approval_get with approval_id, never decide); a blocked policy is an error with code blocked_by_policy. Test keys sandbox mail; use delivered@test.mailcraft.local. Use dry_run to render and lint without sending. Pass idempotency_key to make retries safe.",
  "method": "POST",
  "path": "/v1/emails",
  "mutating": true,
  "parameters": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "from": {
     "type": "string"
    },
    "to": {
     "minItems": 1,
     "maxItems": 50,
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "subject": {
     "type": "string"
    },
    "html": {
     "type": "string"
    },
    "text": {
     "type": "string"
    },
    "template": {
     "type": "object",
     "properties": {
      "id": {
       "type": "string"
      },
      "variables": {
       "type": "object",
       "propertyNames": {
        "type": "string"
       },
       "additionalProperties": {}
      }
     },
     "required": [
      "id"
     ]
    },
    "stream": {
     "type": "string",
     "enum": [
      "transactional",
      "marketing"
     ]
    },
    "tags": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "name": {
        "type": "string"
       },
       "value": {
        "type": "string"
       }
      },
      "required": [
       "name",
       "value"
      ]
     }
    },
    "reply_to": {
     "type": "string"
    },
    "headers": {
     "type": "object",
     "propertyNames": {
      "type": "string"
     },
     "additionalProperties": {
      "type": "string"
     }
    },
    "scheduled_at": {
     "type": "string"
    },
    "dry_run": {
     "type": "boolean"
    },
    "idempotency_key": {
     "description": "Same key + same request returns the original result",
     "type": "string",
     "maxLength": 256
    }
   },
   "required": [
    "to"
   ]
  }
 },
