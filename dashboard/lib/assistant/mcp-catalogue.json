 {
  "name": "kill_switch_status",
  "description": "Whether the workspace kill switch is on (`on`) and which keys are individually paused (`paused_keys`).",
  "method": "GET",
  "path": "/v1/kill-switch",
  "mutating": false,
  "parameters": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {}
  }
 },
 {
  "name": "kill_switch_engage",
  "description": "Emergency stop: halt all sending, or only one key when key_id is given. Only a human (admin) can turn it off again.",
  "method": "POST",
  "path": "/v1/kill-switch",
  "mutating": true,
  "parameters": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "key_id": {
     "description": "pause just this key (UUID); omit for the whole workspace",
     "type": "string"
    },
    "idempotency_key": {
     "description": "Same key + same request returns the original result",
     "type": "string",
     "maxLength": 256
    }
   }
  }
 },
 {
  "name": "doctor",
  "description": "Server-side health and deliverability checks with hints.",
  "method": "GET",
  "path": "/v1/doctor",
  "mutating": false,
  "parameters": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {}
  }
 },
 {
  "name": "audit_list",
  "description": "Audit log of actions taken with API keys.",
  "method": "GET",
  "path": "/v1/audit",
  "mutating": false,
  "parameters": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "limit": {
     "type": "integer",
     "minimum": 1,
     "maximum": 100
    },
    "before": {
     "description": "return rows with id below this (the next_cursor)",
     "type": "integer",
     "minimum": -9007199254740991,
     "maximum": 9007199254740991
    }
   }
  }
 },
 {
  "name": "go_live_request",
  "description": "Ask a human to enable live sending. Creates a go_live approval; poll approval_get. You cannot approve it.",
  "method": "POST",
  "path": "/v1/go-live-requests",
  "mutating": true,
  "parameters": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "note": {
     "type": "string"
    },
    "idempotency_key": {
     "description": "Same key + same request returns the original result",
     "type": "string",
     "maxLength": 256
    }
   }
  }
 },
 {
  "name": "policy_propose",
  "description": "Propose a send-policy change for a key ({send: auto|needs_approval|blocked}); a human approves it.",
  "method": "POST",
  "path": "/v1/policy/proposals",
  "mutating": true,
  "parameters": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {
    "key_id": {
     "type": "string",
     "description": "key id (UUID)"
    },
    "policy": {
     "type": "object",
     "properties": {
      "send": {
       "type": "string",
       "enum": [
        "auto",
        "needs_approval",
        "blocked"
       ]
      }
     }
    },
    "idempotency_key": {
     "description": "Same key + same request returns the original result",
     "type": "string",
     "maxLength": 256
    }
   },
   "required": [
    "key_id",
    "policy"
   ]
  }
 },
 {
  "name": "policy_get",
  "description": "Current send policy (what is auto, needs_approval, blocked).",
  "method": "GET",
  "path": "/v1/policy",
  "mutating": false,
  "parameters": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "properties": {}
  }
 }
]
